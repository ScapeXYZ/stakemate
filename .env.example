# Browser-safe configuration only. Do not store wallet keys or secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_ENV=development
# UI policy marker only; the dApp Kit configuration also hard-limits supported networks to Testnet.
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=false

# Server-side only. Set deployment secrets via your host's secret manager; never commit values.
# TATUM_API_KEY=
# TATUM_SUI_NETWORK=testnet
# Testnet and Devnet use the native TLS gRPC gateway by default. Supply only a host:port override when Tatum directs you to do so.
# TATUM_SUI_GRPC_ENDPOINT=sui-testnet-grpc.gateway.tatum.io:443
# TATUM_SUI_RPC_URL= is a legacy JSON-RPC override used only by the Mainnet compatibility path.
# TATUM_TIMEOUT_MS=8000
#
# Walrus Memory production configuration. This adapter deliberately targets Mainnet only.
# WALRUS_MEMORY_NETWORK=mainnet
# WALRUS_MEMORY_RELAYER_URL=https://relayer.memory.walrus.xyz
# WALRUS_MEMORY_ACCOUNT_ID=
# WALRUS_MEMORY_DELEGATE_KEY=
# WALRUS_MEMORY_NAMESPACE=stakemate
# WALRUS_MEMORY_WRITES_ENABLED=false
# Required only after explicit write approval. Must be absolute and outside this repository/public assets; use a host-managed persistent path or replace the file store with a database ReceiptStore.
# WALRUS_MEMORY_RECEIPTS_PATH=/var/lib/stakemate/walrus-memory-receipts.json
# Required only if WALRUS_MEMORY_WRITES_ENABLED=true. Use a non-secret, externally recorded approval/change ID.
# WALRUS_MEMORY_WRITE_APPROVAL_ID=
# AI_PROVIDER_API_KEY=

# Remote MCP stays disabled unless a separately reviewed HTTPS OAuth resource
# server and consent/revocation store are deployed. These are server-only.
# STAKEMATE_REMOTE_MCP_ENABLED=false
# STAKEMATE_REMOTE_MCP_ORIGIN=https://app.example.com
# STAKEMATE_REMOTE_MCP_OAUTH_ISSUER=https://oauth.example.com
# STAKEMATE_REMOTE_MCP_OAUTH_AUDIENCE=https://app.example.com/api/mcp
# STAKEMATE_REMOTE_MCP_JWKS_URI=https://oauth.example.com/.well-known/jwks.json

# Invitation profiles/authentication. A real transactional Postgres InvitationStore is required
# before these features are enabled; no in-memory fallback is used in production.
# DATABASE_URL=postgresql://stakemate:CHANGE_ME@db.example/stakemate?sslmode=require
# STAKEMATE_PUBLIC_ORIGIN=https://app.example.com

# Verified-market providers are deliberately disabled until provider-specific adapters,
# credentials, source terms, and end-to-end verification have been reviewed.
# Never expose either value to NEXT_PUBLIC_* or browser code.
# football-data.org v4 server-side token. Approved competition scope is PL, PD, CL only.
# FOOTBALL_DATA_API_TOKEN=
# CRYPTO_PRICE_PROVIDER_API_KEY=
